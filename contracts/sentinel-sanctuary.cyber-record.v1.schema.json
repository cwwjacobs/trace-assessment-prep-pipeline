{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel-sanctuary.cyber-record.v1",
  "title": "SentinelSanctuary defensive cyber Ingot record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "emission_type",
    "case_type",
    "scenario_family_id",
    "fixture_root_sha256",
    "root_cause_mechanic_id",
    "narrative_id",
    "replay_mode",
    "lineage",
    "governance",
    "evaluation",
    "model_witness",
    "execution_witness",
    "finding_codes",
    "evidence_ref_sha256s",
    "decision_episode_sha256s",
    "gap_codes",
    "split_group_ids"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"
    }
  },
  "properties": {
    "schema_id": {"const": "sentinel-sanctuary.cyber-record.v1"},
    "emission_type": {"$ref": "#/$defs/code"},
    "case_type": {"$ref": "#/$defs/code"},
    "scenario_family_id": {"$ref": "#/$defs/identifier"},
    "fixture_root_sha256": {"$ref": "#/$defs/sha256"},
    "root_cause_mechanic_id": {"$ref": "#/$defs/identifier"},
    "narrative_id": {"$ref": "#/$defs/identifier"},
    "replay_mode": {
      "enum": ["CAPTURED_EXACT", "DETERMINISTIC_POLICY", "FRESH_SEMANTIC_NONDETERMINISTIC"]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_run_sha256", "checkpoint_sha256", "compared_core_sha256s"],
      "properties": {
        "parent_run_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "checkpoint_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "compared_core_sha256s": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_receipt_sha256",
        "rights_manifest_sha256",
        "privacy_ruleset_sha256",
        "retention_policy_sha256",
        "provider_disclosure_policy_sha256",
        "commercial_rights_status",
        "provider_submission_authorized",
        "raw_evidence_disposition"
      ],
      "properties": {
        "authorization_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "rights_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "privacy_ruleset_sha256": {"$ref": "#/$defs/sha256"},
        "retention_policy_sha256": {"$ref": "#/$defs/sha256"},
        "provider_disclosure_policy_sha256": {"$ref": "#/$defs/sha256"},
        "commercial_rights_status": {"enum": ["VERIFIED", "HOLD"]},
        "provider_submission_authorized": {"const": true},
        "raw_evidence_disposition": {
          "enum": ["ENCRYPTED_QUARANTINE_ONLY", "PURGED_WITH_RECEIPT"]
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_sha256",
        "scoring_rules_sha256",
        "split_policy_sha256",
        "split_assignment_sha256",
        "split_role",
        "contamination_scan_sha256",
        "contamination_status",
        "evaluation_case_sha256s",
        "evaluation_result_sha256s"
      ],
      "properties": {
        "oracle_sha256": {"$ref": "#/$defs/sha256"},
        "scoring_rules_sha256": {"$ref": "#/$defs/sha256"},
        "split_policy_sha256": {"$ref": "#/$defs/sha256"},
        "split_assignment_sha256": {"$ref": "#/$defs/sha256"},
        "split_role": {"enum": ["TRAIN", "VALIDATION", "TEST", "HOLDOUT"]},
        "contamination_scan_sha256": {"$ref": "#/$defs/sha256"},
        "contamination_status": {"enum": ["CLEAR", "HOLD"]},
        "evaluation_case_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "evaluation_result_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "model_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_family",
        "endpoint_origin_sha256",
        "requested_model_id",
        "returned_model_id",
        "model_snapshot_pinned",
        "system_fingerprint_sha256",
        "request_sha256",
        "response_sha256",
        "request_parameters_sha256",
        "tool_schema_sha256",
        "provider_request_id_sha256",
        "client_request_id_sha256",
        "usage_sha256",
        "data_control_profile_sha256",
        "store_requested",
        "seed_requested",
        "seed_support",
        "output_reproducibility"
      ],
      "properties": {
        "api_family": {"enum": ["openai.responses.v1", "openai.chat.completions.v1"]},
        "endpoint_origin_sha256": {"$ref": "#/$defs/sha256"},
        "requested_model_id": {"$ref": "#/$defs/identifier"},
        "returned_model_id": {"$ref": "#/$defs/identifier"},
        "model_snapshot_pinned": {"type": "boolean"},
        "system_fingerprint_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "response_sha256": {"$ref": "#/$defs/sha256"},
        "request_parameters_sha256": {"$ref": "#/$defs/sha256"},
        "tool_schema_sha256": {"$ref": "#/$defs/sha256"},
        "provider_request_id_sha256": {"$ref": "#/$defs/sha256"},
        "client_request_id_sha256": {"$ref": "#/$defs/sha256"},
        "usage_sha256": {"$ref": "#/$defs/sha256"},
        "data_control_profile_sha256": {"$ref": "#/$defs/sha256"},
        "store_requested": {"type": "boolean"},
        "seed_requested": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "seed_support": {"enum": ["SUPPORTED", "UNSUPPORTED", "UNKNOWN"]},
        "output_reproducibility": {"const": "NOT_CLAIMED"}
      }
    },
    "execution_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "profile",
        "assurance_class",
        "execution_envelope_sha256",
        "adapter_schema_sha256",
        "observer_issuer_id",
        "observer_key_id",
        "observer_authentication",
        "road_frozen_sha256",
        "road_walked_sha256",
        "road_diff_sha256",
        "execution_receipt_sha256",
        "runtime_identity_sha256",
        "runtime_asset_lock_sha256",
        "job_image_sha256",
        "host_preflight_sha256",
        "proxy_peer_sha256",
        "guest_evidence_root",
        "ciphertext_sha256",
        "ciphertext_size_bytes",
        "egress_event_root",
        "host_lifecycle_root",
        "evidence_recoverability",
        "gate_decision",
        "cleanup_status",
        "credential_channel_closed",
        "provider_credential_revocation_receipt_sha256"
      ],
      "properties": {
        "executor": {"const": "cinderfield"},
        "profile": {"$ref": "#/$defs/identifier"},
        "assurance_class": {"enum": ["PORTABLE_VERIFIED_HARDWARE_PENDING", "SUPPORTED_HOST_VERIFIED"]},
        "execution_envelope_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_schema_sha256": {"$ref": "#/$defs/sha256"},
        "observer_issuer_id": {"$ref": "#/$defs/identifier"},
        "observer_key_id": {"$ref": "#/$defs/identifier"},
        "observer_authentication": {"enum": ["LOCAL_HMAC_VERIFIED", "ASYMMETRIC_VERIFIED"]},
        "road_frozen_sha256": {"$ref": "#/$defs/sha256"},
        "road_walked_sha256": {"$ref": "#/$defs/sha256"},
        "road_diff_sha256": {"$ref": "#/$defs/sha256"},
        "execution_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_identity_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_asset_lock_sha256": {"$ref": "#/$defs/sha256"},
        "job_image_sha256": {"$ref": "#/$defs/sha256"},
        "host_preflight_sha256": {"$ref": "#/$defs/sha256"},
        "proxy_peer_sha256": {"$ref": "#/$defs/sha256"},
        "guest_evidence_root": {"$ref": "#/$defs/sha256"},
        "ciphertext_sha256": {"$ref": "#/$defs/sha256"},
        "ciphertext_size_bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "egress_event_root": {"$ref": "#/$defs/sha256"},
        "host_lifecycle_root": {"$ref": "#/$defs/sha256"},
        "evidence_recoverability": {"enum": ["STRUCTURAL_ONLY", "DECRYPTABLE_VERIFIED"]},
        "gate_decision": {"enum": ["ALLOW", "DENY", "RESCOPE_REQUIRED", "EVALUATION_INCOMPLETE"]},
        "cleanup_status": {"enum": ["VERIFIED", "UNVERIFIED"]},
        "credential_channel_closed": {"type": "boolean"},
        "provider_credential_revocation_receipt_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "finding_codes": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/code"}
    },
    "evidence_ref_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "decision_episode_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "gap_codes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/code"}
    },
    "split_group_ids": {
      "type": "array",
      "minItems": 6,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    }
  }
}
