{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gtdataworks.native-operational-telemetry-manifest.v1",
  "title": "GTDataworks private native operational telemetry HOLD manifest",
  "description": "Exact manifest for a private, non-release structural telemetry derivative of one verified native run.v7 bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "product_kind",
    "product_version",
    "source",
    "projection_ruleset",
    "governance",
    "counts",
    "files"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "registry_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "adapter",
        "capture_mode",
        "adapter_spec_sha256",
        "source_manifest_sha256",
        "event_head_sha256",
        "native_trace_index_sha256",
        "selected_source_sha256",
        "archive_sha256"
      ],
      "properties": {
        "provider": {
          "enum": [
            "agy",
            "claude",
            "codex",
            "grok",
            "chatgpt",
            "claude-export"
          ]
        },
        "adapter": {
          "enum": [
            "goldentrace.native-trace.agy-jsonl.v1",
            "goldentrace.native-trace.claude-session-jsonl.v1",
            "goldentrace.native-trace.codex-rollout-jsonl.v1",
            "goldentrace.native-trace.grok-session-jsonl.v1",
            "goldentrace.native-trace.grok-session-json.v1",
            "goldentrace.native-trace.chatgpt-conversation-json.v1",
            "goldentrace.native-trace.claude-conversation-json.v1"
          ]
        },
        "capture_mode": {
          "enum": [
            "historical_jsonl_import",
            "historical_session_jsonl_import",
            "historical_rollout_jsonl_import",
            "historical_session_json_import",
            "historical_conversation_json_import"
          ]
        },
        "adapter_spec_sha256": {
          "$ref": "#/$defs/digest"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "event_head_sha256": {
          "$ref": "#/$defs/digest"
        },
        "native_trace_index_sha256": {
          "$ref": "#/$defs/digest"
        },
        "selected_source_sha256": {
          "$ref": "#/$defs/digest"
        },
        "archive_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "provider": {
                  "const": "agy"
                },
                "adapter": {
                  "const": "goldentrace.native-trace.agy-jsonl.v1"
                },
                "capture_mode": {
                  "const": "historical_jsonl_import"
                },
                "adapter_spec_sha256": {
                  "const": "fc4f72622ef3bbda1401585fa84d23ef302d82f939f7b0515a6d90d46c054cb3"
                }
              }
            },
            {
              "properties": {
                "provider": {
                  "const": "claude"
                },
                "adapter": {
                  "const": "goldentrace.native-trace.claude-session-jsonl.v1"
                },
                "capture_mode": {
                  "const": "historical_session_jsonl_import"
                },
                "adapter_spec_sha256": {
                  "const": "d705e4cb107ca7bfd884d3d471e0ca15fc024dba4ab332d541c02c21230ef527"
                }
              }
            },
            {
              "properties": {
                "provider": {
                  "const": "codex"
                },
                "adapter": {
                  "const": "goldentrace.native-trace.codex-rollout-jsonl.v1"
                },
                "capture_mode": {
                  "const": "historical_rollout_jsonl_import"
                },
                "adapter_spec_sha256": {
                  "const": "a883629c1e29831b713d4ba4a2eb3be8fd1c7ce97e97aa7b9a26c4817b39a6b6"
                }
              }
            },
            {
              "properties": {
                "provider": {
                  "const": "grok"
                },
                "adapter": {
                  "const": "goldentrace.native-trace.grok-session-jsonl.v1"
                },
                "capture_mode": {
                  "const": "historical_session_jsonl_import"
                },
                "adapter_spec_sha256": {
                  "const": "bede8fd422e938cb9d53d08f58a9304a583053ed0ecde759a97264d07070bf95"
                }
              }
            },
            {
              "properties": {
                "provider": {
                  "const": "grok"
                },
                "adapter": {
                  "const": "goldentrace.native-trace.grok-session-json.v1"
                },
                "capture_mode": {
                  "const": "historical_session_json_import"
                },
                "adapter_spec_sha256": {
                  "const": "57587d01e5090808b5f4cbc07e6d3a1045cf782a86cf38cba16f5b1f802f2670"
                }
              }
            },
            {
              "properties": {
                "provider": {
                  "const": "chatgpt"
                },
                "adapter": {
                  "const": "goldentrace.native-trace.chatgpt-conversation-json.v1"
                },
                "capture_mode": {
                  "const": "historical_conversation_json_import"
                },
                "adapter_spec_sha256": {
                  "const": "dfd78f1ef9e0564f9f0eb48ac8e0076198a05fe32d79e12bbe3fbda3b542c57e"
                }
              }
            },
            {
              "properties": {
                "provider": {
                  "const": "claude-export"
                },
                "adapter": {
                  "const": "goldentrace.native-trace.claude-conversation-json.v1"
                },
                "capture_mode": {
                  "const": "historical_conversation_json_import"
                },
                "adapter_spec_sha256": {
                  "const": "2e11dada76b58f200ef57503fd8eae8190a0021349b5a812bd4d92267b3df95b"
                }
              }
            }
          ]
        }
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "rights_status",
        "disposition",
        "release_admitted",
        "training_readiness",
        "reasoning_policy"
      ],
      "properties": {
        "visibility": {
          "const": "PRIVATE"
        },
        "rights_status": {
          "const": "UNKNOWN"
        },
        "disposition": {
          "const": "HOLD"
        },
        "release_admitted": {
          "const": false
        },
        "training_readiness": {
          "const": "NOT_TRAINING_READY"
        },
        "reasoning_policy": {
          "const": "EXCLUDE"
        }
      }
    }
  },
  "properties": {
    "schema_id": {
      "const": "gtdataworks.native-operational-telemetry-manifest.v1"
    },
    "product_kind": {
      "const": "PRIVATE_NATIVE_OPERATIONAL_TELEMETRY_HOLD"
    },
    "product_version": {
      "const": "1.0.0"
    },
    "source": {
      "$ref": "#/$defs/registry_source"
    },
    "projection_ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "sha256"
      ],
      "properties": {
        "identity": {
          "const": "gtdataworks.native-operational-telemetry-projection.v1"
        },
        "sha256": {
          "const": "847bde56135cb4b166c7a23cbae56997b1b51fe3faebf38c1069d3e159bf5c4b"
        }
      }
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "known_record_count",
        "unknown_record_count",
        "malformed_record_count",
        "oversize_record_count",
        "privacy_receipt_count"
      ],
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "known_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "malformed_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "oversize_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "privacy_receipt_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "name": {
            "enum": [
              "DATACARD.md",
              "provenance/lineage.jsonl",
              "provenance/privacy-receipts.jsonl",
              "telemetry.jsonl"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  }
}
